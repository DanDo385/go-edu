                "41-signed-transactions-ed25519",
                "42-simple-block-struct-hashing",
                "43-proof-of-work-demo",
                "44-mempool-in-memory",
                "45-p2p-gossip-mock-network",
                "46-generics-map-reduce",
                "47-plugin-system-hot-reload",
                "48-reflection-introspection",
