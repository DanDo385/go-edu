{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "showLog": true,
            "env": {},
            "args": []
        },
        {
            "name": "Debug Tests (Current Package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v"
            ],
            "showLog": true
        },
        {
            "name": "Debug cmd/dev (Debug Harness)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}/cmd/dev",
            "cwd": "${fileDirname}",
            "showLog": true,
            "env": {},
            "args": []
        },
        {
            "name": "Debug cmd/app (CLI)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}/cmd/app",
            "cwd": "${fileDirname}",
            "showLog": true,
            "env": {},
            "args": []
        },
        {
            "name": "Debug Tests with Reference",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v"
            ],
            "buildFlags": "-tags=reference",
            "showLog": true
        }
    ]
}
