{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: cmd/dev (Auto - from internal)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}/../../cmd/dev",
            "showLog": true,
            "comment": "Run this when you have an exercise file open in internal/pkg/ to run the debug harness"
        },
        {
            "name": "Debug: cmd/app (Auto - from internal)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}/../../cmd/app",
            "showLog": true,
            "comment": "Run this when you have an exercise file open in internal/pkg/ to run the main app"
        },
        {
            "name": "Debug: Current File/Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "showLog": true,
            "comment": "Debugs the current package or file"
        },
        {
            "name": "Test: Current Package",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "showLog": true
        },
        {
            "name": "Test: Run All Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/...",
            "showLog": true
        }
    ]
}