{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "showLog": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Tests (Current Package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": ["-test.v"],
            "showLog": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug cmd/dev (Auto-detect Project)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/${relativeFileDirname}/../../../cmd/dev",
            "showLog": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug cmd/app (Auto-detect Project)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/${relativeFileDirname}/../../../cmd/app",
            "showLog": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Tests with Reference Solution",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": ["-test.v"],
            "buildFlags": "-tags=reference",
            "showLog": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Single Test with Reference (TitleCase)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": ["-test.v", "-test.run", "TestTitleCase"],
            "buildFlags": "-tags=reference",
            "showLog": true,
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug cmd/dev with Reference (Stop at Entry)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/minis/01-hello-strings/cmd/dev",
            "buildFlags": "-tags=reference",
            "showLog": true,
            "stopOnEntry": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}",
            "dlvLoadConfig": {
                "followPointers": true,
                "maxVariableRecurse": 1,
                "maxStringLen": 64,
                "maxArrayValues": 64,
                "maxStructFields": -1
            }
        },
        {
            "name": "Debug cmd/dev with Reference Solution",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/${relativeFileDirname}/../../../cmd/dev",
            "buildFlags": "-tags=reference",
            "showLog": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Selected Mini Project (cmd/dev) with Reference",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/minis/${input:miniProject}/cmd/dev",
            "buildFlags": "-tags=reference",
            "showLog": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Selected Mini Project (cmd/dev)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/minis/${input:miniProject}/cmd/dev",
            "showLog": true,
            "env": {},
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Selected Geth Project (cmd/dev)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/geth/${input:gethProject}/cmd/dev",
            "showLog": true,
            "env": {
                "INFURA_RPC_URL": "${env:INFURA_RPC_URL}"
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "miniProject",
            "type": "pickString",
            "description": "Select a minis project",
            "options": [
                "01-hello-strings",
