{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Debug current package (auto)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${fileDirname}"
    },
    {
      "name": "Go: Debug tests (current package)",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Go: Debug cmd/app (pick project)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/${input:projectPath}/cmd/app",
      "args": []
    },
    {
      "name": "Go: Debug cmd/dev (pick project)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/${input:projectPath}/cmd/dev",
      "args": []
    }
  ],
  "inputs": [
    {
      "id": "projectPath",
      "type": "promptString",
      "description": "Project path, e.g. minis/01-hello-strings or geth/01-stack",
      "default": "minis/01-hello-strings"
    }
  ]
}

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "showLog": true,
            "env": {},
            "args": []
        },
        {
            "name": "Debug Tests (Current Package)",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v"
            ],
            "showLog": true
        },
        {
            "name": "Debug cmd/dev (Debug Harness)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/dev",
            "showLog": true,
            "env": {},
            "args": []
        },
        {
            "name": "Debug cmd/app (CLI)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/app",
            "showLog": true,
            "env": {},
            "args": []
        },
        {
            "name": "Debug Tests with Reference",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "args": [
                "-test.v"
            ],
            "buildFlags": "-tags=reference",
            "showLog": true
        }
    ]
}
