{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: cmd/app",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/app",
            "args": [],
            "noDebug": true
        },
        {
            "name": "Debug: cmd/dev",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/dev",
            "args": [],
            "showLog": true,
            "buildFlags": "-gcflags=all=-N -l"
        },
        {
            "name": "Test: Run All Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/filestreamingbufio",
            "args": [
                "-test.v"
            ],
            "showLog": true,
            "buildFlags": "-gcflags=all=-N -l"
        },
        {
            "name": "Test: Current Test Function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/filestreamingbufio",
            "args": [
                "-test.v",
                "-test.run",
                "${selectedText}"
            ],
            "showLog": true,
            "buildFlags": "-gcflags=all=-N -l"
        },
        {
            "name": "Test: View Reference Implementation",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/internal/filestreamingbufio",
            "args": [
                "-test.v"
            ],
            "showLog": true,
            "buildFlags": "-tags=reference -gcflags=all=-N -l"
        },
        {
            "name": "Debug: Current File",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${file}"
        }
    ]
}