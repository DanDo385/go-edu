{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: cmd/app",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/minis/26-sync-once-singleton/cmd/app",
            "args": [],
            "showLog": true,
            "trace": "log",
            "buildFlags": "-gcflags='-N -l'",
            "comment": "Debug the application entry point. Edit args[] to pass CLI arguments."
        },
        {
            "name": "Debug: cmd/dev (Debug Harness)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/minis/26-sync-once-singleton/cmd/dev",
            "args": [],
            "showLog": true,
            "trace": "log",
            "buildFlags": "-gcflags='-N -l'",
            "comment": "Debug harness with fixed inputs - perfect for stepping through code."
        },
        {
            "name": "Test: Run All Tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/minis/26-sync-once-singleton/internal/synconcesingleton",
            "args": [
                "-test.v"
            ],
            "showLog": true,
            "trace": "log",
            "buildFlags": "-gcflags='-N -l'",
            "comment": "Run all tests with verbose output."
        },
        {
            "name": "Test: Current Test Function",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/minis/26-sync-once-singleton/internal/synconcesingleton",
            "args": [
                "-test.v",
                "-test.run",
                "^${selectedText}$"
            ],
            "showLog": true,
            "buildFlags": "-gcflags='-N -l'",
            "comment": "Debug specific test - select test name in editor first."
        },
        {
            "name": "Test: View Reference Implementation",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/minis/26-sync-once-singleton/internal/synconcesingleton",
            "args": [
                "-tags=reference",
                "-test.v"
            ],
            "showLog": true,
            "trace": "log",
            "buildFlags": "-gcflags='-N -l'",
            "comment": "Run tests with reference implementation (solution.reference.go)."
        },
        {
            "name": "Debug: Current File",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${fileDirname}",
            "args": [],
            "showLog": true,
            "buildFlags": "-gcflags='-N -l'",
            "comment": "Debug currently open file."
        }
    ]
}
